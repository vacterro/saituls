Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\shell\OpenWithFreebuff]
@="Open with Freebuff"
"Icon"="C:\\Users\\vac34\\freebuff.exe"
"HasLUAShield"=""

[HKEY_CLASSES_ROOT\Directory\shell\OpenWithFreebuff\command]
@="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process -Verb RunAs -FilePath 'C:\\Users\\vac34\\freebuff.exe' -WorkingDirectory '%1'\""

[HKEY_CLASSES_ROOT\Directory\Background\shell\OpenWithFreebuff]
@="Open with Freebuff"
"Icon"="C:\\Users\\vac34\\freebuff.exe"
"HasLUAShield"=""

[HKEY_CLASSES_ROOT\Directory\Background\shell\OpenWithFreebuff\command]
@="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process -Verb RunAs -FilePath 'C:\\Users\\vac34\\freebuff.exe' -WorkingDirectory '%V'\""
